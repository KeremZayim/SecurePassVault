<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.securevault.controller.VaultController">

    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <TextField fx:id="searchField" promptText="Search..."/>
            <Button fx:id="addButton" text="Add"/>
            <Button fx:id="updateButton" text="Update"/>
            <Button fx:id="deleteButton" text="Delete"/>
            <Button fx:id="copyButton" text="Copy Password"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="passwordTable" prefHeight="400" prefWidth="600">
            <columns>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="150"/>
                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="150"/>
                <TableColumn fx:id="passwordColumn" text="Password" prefWidth="150"/>
                <TableColumn fx:id="notesColumn" text="Notes" prefWidth="150"/>
            </columns>
        </TableView>
    </center>

</BorderPane>
