<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="500" prefWidth="350.0" spacing="20"
      style="-fx-background-color: linear-gradient(to bottom right, #4E54C8, #8F94FB);"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.securevault.controller.LoginController">

    <VBox alignment="CENTER" prefWidth="350.0" spacing="15"
          style="-fx-background-color: white; -fx-padding: 40;
                 -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0, 0, 5);">

        <Label fx:id="titleLabel"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4E54C8;"
               text="SecurePassVault" />

        <VBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="usernameLabel"
                   style="-fx-text-fill: #555555;" text="Username" />
            <TextField fx:id="usernameField"
                       promptText="Enter username"
                       style="-fx-background-color: transparent; -fx-border-width: 0 0 2 0;
                              -fx-border-color: #4E54C8; -fx-padding: 5 0 5 0;" />
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="passwordLabel"
                   style="-fx-text-fill: #555555;" text="Password" />
            <PasswordField fx:id="passwordField"
                           promptText="Enter password"
                           style="-fx-background-color: transparent; -fx-border-width: 0 0 2 0;
                                  -fx-border-color: #4E54C8; -fx-padding: 5 0 5 0;" />
        </VBox>

        <Button fx:id="loginButton" maxWidth="Infinity"
                style="-fx-background-color: #4E54C8; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 10; -fx-padding: 10 20;"
                text="Login" />

        <Label fx:id="messageLabel" style="-fx-text-fill: red; -fx-font-size: 12px;" />

        <!-- Dil seçimi alanı -->
        <HBox alignment="BOTTOM_RIGHT" spacing="5" prefWidth="Infinity">
            <Region HBox.hgrow="ALWAYS" />
            <MenuButton fx:id="languageMenu" text="🌐"
                        style="-fx-background-color: transparent; -fx-text-fill: #4E54C8;">
                <items>
                    <MenuItem fx:id="turkishItem" text="🇹🇷 Türkçe" />
                    <MenuItem fx:id="englishItem" text="🇬🇧 English" />
                    <MenuItem fx:id="germanItem" text="🇩🇪 Deutsch" />
                    <MenuItem fx:id="spanishItem" text="🇪🇸 Español" />
                </items>
            </MenuButton>
        </HBox>
    </VBox>
</VBox>
